#!/usr/bin/env python3
"""Route KakaoTalk's new-message notifications to desktop notifications; clicking one shows KakaoTalk.

Two modes (KAKAO_NOTIFY_MODE):

popup (default): KakaoTalk's own popup (an untitled layered window that opens at the bottom
edge of the screen, plus its "KakaoTalkShadowWnd") is moved to a hidden special workspace as
soon as Hyprland maps it, and a notification titled with the room name says "새 메시지" (no
message text). The room name comes from the launcher: it runs KakaoTalk with Wine's +text trace
and pipes stderr through `kakaotalk-notify relay LOG`, which picks the popup's room name out of
the DrawTextExW calls, sends only that to $XDG_RUNTIME_DIR/kakaotalk-notify/room.sock and drops
every other trace line (other stderr lines go to LOG). Without it the title is "카카오톡".
KakaoTalk only shows popups for rooms whose notifications are on, so its own per-room mute
setting applies.

wal: for when KakaoTalk shows no popups. Watches chat_data/chatLogs_<roomId>.edb-wal with
inotifywait (names only; the encrypted contents are never read) and sends one "새 메시지"
notification per room per burst, never while a KakaoTalk window is focused. KakaoTalk's mute
setting is unreadable here, so each notification has a "이 방 알림 끄기" button that adds the
room id to ~/.config/kakaotalk-notify/muted (one id per line; delete a line to unmute).

Usage: kakaotalk-notify             (started by Hyprland autostart; see docs/notifications.md)
       kakaotalk-notify relay LOG   (stderr filter used by the kakaotalk launcher)

Testing overrides:
  KAKAO_CHAT_DATA_GLOB  glob of chat_data dirs to watch
  KAKAO_NOTIFY_MUTED    path of the muted-rooms file
  NOTIFY_CMD            command prefix; headline and body (and, in wal mode, the room id) are
                        appended; in wal mode a stdout line "mute" or "default" is handled like
                        the notification's action
  ACTIVE_CLASS_CMD      command printing the active window class
"""
import glob
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time

ICON = os.path.expanduser("~/.local/share/icons/kakaotalk.png")
DEFAULT_GLOB = os.path.expanduser(
    "~/.local/share/kakaotalk-ec/prefix/drive_c/users/*/AppData/Local/Kakao/KakaoTalk/users/*/chat_data"
)
ROOM_FILE = re.compile(r"^chatLogs_(\d+)\.edb-wal$")
HEADLINE = "카카오톡"
BODY = "새 메시지"
DEBOUNCE = 5.0  # seconds; one message is a burst of writes within about a second
RESCAN = 30  # seconds between looks for account dirs
KAKAO_CLASS = "kakaotalk.exe"


def log(msg):
    print(f"kakaotalk-notify: {msg}", file=sys.stderr, flush=True)


def active_class():
    cmd = os.environ.get("ACTIVE_CLASS_CMD")
    try:
        if cmd:
            out = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=2).stdout
            return out.strip()
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout
        return (json.loads(out or "{}") or {}).get("class", "")
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        log(f"active window lookup failed: {e}")
        return ""


MUTED_FILE = os.environ.get("KAKAO_NOTIFY_MUTED") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kakaotalk-notify", "muted")


class Muted:
    """Room ids from MUTED_FILE, re-read whenever the file changes."""

    def __init__(self):
        self.mtime = None
        self.ids = set()
        self.lock = threading.Lock()

    def __contains__(self, room):
        try:
            mtime = os.stat(MUTED_FILE).st_mtime_ns
        except FileNotFoundError:
            mtime = None
        if mtime != self.mtime:
            self.mtime = mtime
            self.ids = set()
            if mtime is not None:
                with open(MUTED_FILE, encoding="utf-8") as f:
                    self.ids = {line.split("#")[0].strip() for line in f} - {""}
        return room in self.ids

    def add(self, room):
        with self.lock:
            if room in self:
                return
            os.makedirs(os.path.dirname(MUTED_FILE), exist_ok=True)
            with open(MUTED_FILE, "a", encoding="utf-8") as f:
                f.write(f"{room}  # muted {time.strftime('%F %T')}\n")
            log(f"muted room {room}")


def notify_argv(room):
    cmd = os.environ.get("NOTIFY_CMD")
    if cmd:
        return shlex.split(cmd) + [HEADLINE, BODY, room]
    return ["notify-send", "--app-name", HEADLINE, "--icon", ICON,
            "--action", "default=열기", "--action", "mute=이 방 알림 끄기", HEADLINE, BODY]


def notify(room, muted):
    """Show one notification and act on the chosen action (runs in its own thread)."""
    try:
        proc = subprocess.Popen(notify_argv(room), stdout=subprocess.PIPE, text=True)
    except OSError as e:
        log(f"notification failed: {e}")
        return
    for line in proc.stdout:
        action = line.strip()
        if action == "mute":
            muted.add(room)
        elif action == "default":
            subprocess.Popen(["kakaotalk"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        elif action:
            print(action, flush=True)
    proc.wait()


RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kakaotalk-notify")
ROOM_SOCK = os.path.join(RUNTIME, "room.sock")
HIDDEN_WS = "special:katokpopup"
ROOM_WAIT = 3.0  # seconds after a popup opens to wait for its room name before notifying without one

# Wine's +text trace of DrawTextExW: the string (debugstr escapes) and its rectangle.
DRAW = re.compile(r':trace:text:DrawTextExW L"(.*)", -?\d+, \[\((-?\d+),(-?\d+)\)-')
ESCAPE = re.compile(r"\\(x[0-9a-fA-F]{2}|[0-9a-fA-F]{4}|.)")
SEND = "전송"  # the popup's reply button, drawn last


def unescape(s):
    def one(m):
        e = m.group(1)
        if len(e) == 4 or e[0] == "x":
            return chr(int(e.lstrip("x"), 16))
        return {"n": "\n", "r": "\r", "t": "\t"}.get(e, e)
    return ESCAPE.sub(one, s)


def popup_room(draws):
    """Room name of a popup whose drawing just ended with SEND, or None.

    A popup draws the room name at its top-left corner, then sender and message in one column
    (plus "..." when cut), then SEND. Only the room name leaves this function.
    """
    for i in range(len(draws) - 2, max(len(draws) - 8, -1), -1):
        text, x, y = draws[i]
        if x == 0 and 0 <= y <= 4:
            column = {dx for _, dx, _ in draws[i + 1:-1]}
            return text if text and len(column) == 1 and column != {0} else None
    return None


def relay(log_path):
    """Stderr filter for the launcher: popup room names go to ROOM_SOCK, other lines to the log.

    Wine's text trace carries everything KakaoTalk draws, so it is never written anywhere.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    sock.setblocking(False)
    draws = []
    with open(log_path, "ab", buffering=0) as out:
        for raw in sys.stdin.buffer:
            if b":trace:text:" not in raw:
                out.write(raw)
                continue
            m = DRAW.search(raw.decode("utf-8", "replace"))
            if not m:
                continue
            draws = draws[-7:] + [(unescape(m.group(1)), int(m.group(2)), int(m.group(3)))]
            room = popup_room(draws) if draws[-1][0] == SEND else None
            if room:
                try:
                    sock.sendto(room.encode(), ROOM_SOCK)
                except OSError:
                    pass  # notifier not running


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5).stdout


def client(address):
    try:
        return next((c for c in json.loads(hyprctl("clients", "-j")) if c["address"] == address), None)
    except (ValueError, subprocess.SubprocessError) as e:
        log(f"hyprctl clients failed: {e}")
        return None


def opens_at_bottom(c):
    """KakaoTalk's popup is mapped at the monitor's bottom edge before it slides into place."""
    try:
        m = next(m for m in json.loads(hyprctl("monitors", "-j")) if m["id"] == c["monitor"])
    except (StopIteration, ValueError, subprocess.SubprocessError):
        return False
    return c["at"][1] >= m["y"] + round(m["height"] / m["scale"]) - 8


def hide(address):
    target = f"address:{address}"
    hyprctl("dispatch", f'hl.dsp.window.pin({{ action = "disable", window = "{target}" }})')
    hyprctl("dispatch", f'hl.dsp.window.move({{ workspace = "{HIDDEN_WS}", window = "{target}", follow = false }})')


def notify_room(room):
    argv = ["omarchy", "notification", "send", "--app-name", HEADLINE, "-i", ICON,
            room or HEADLINE, BODY, "--exec", "kakaotalk"]
    cmd = os.environ.get("NOTIFY_CMD")
    if cmd:
        argv = shlex.split(cmd) + [room or HEADLINE, BODY]
    log(f"popup: notified ({'room' if room else 'no room name'})")
    try:
        subprocess.run(argv, stdout=subprocess.DEVNULL)
    except OSError as e:
        log(f"notification failed: {e}")


class Popups:
    """Pairs each opened popup with the next room name drawn in it; repaints of a popup draw its
    room again, and those arrive with no open popup waiting and are dropped."""

    def __init__(self):
        self.lock = threading.Lock()
        self.waiting = []  # ids of popups opened but not yet notified, oldest first
        self.next_id = 0

    def opened(self):
        with self.lock:
            pid = self.next_id
            self.next_id += 1
            self.waiting.append(pid)
        threading.Timer(ROOM_WAIT, self.timeout, args=(pid,)).start()

    def timeout(self, pid):
        with self.lock:
            if pid not in self.waiting:
                return
            self.waiting.remove(pid)
        notify_room("")

    def room(self, name):
        with self.lock:
            if not self.waiting:
                return
            self.waiting.pop(0)
        notify_room(name)


def listen_rooms(popups):
    os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
    if os.path.exists(ROOM_SOCK):
        os.remove(ROOM_SOCK)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    sock.bind(ROOM_SOCK)
    while True:
        name = sock.recv(4096).decode("utf-8", "replace")
        threading.Thread(target=popups.room, args=(name,), daemon=True).start()


def main_popup():
    popups = Popups()
    threading.Thread(target=listen_rooms, args=(popups,), daemon=True).start()
    path = f'{os.environ["XDG_RUNTIME_DIR"]}/hypr/{os.environ["HYPRLAND_INSTANCE_SIGNATURE"]}/.socket2.sock'
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(path)
    buf = b""
    while chunk := sock.recv(65536):
        *lines, buf = (buf + chunk).split(b"\n")
        for line in lines:
            event, _, data = line.decode(errors="replace").partition(">>")
            if event != "openwindow":
                continue
            addr, _ws, cls, title = (data.split(",", 3) + ["", "", "", ""])[:4]
            if cls != KAKAO_CLASS or title not in ("", "KakaoTalkShadowWnd"):
                continue
            address = "0x" + addr
            if title == "KakaoTalkShadowWnd":
                hide(address)
                continue
            c = client(address)
            if not c or not opens_at_bottom(c):
                continue  # menus and tooltips are untitled too
            hide(address)
            popups.opened()
    raise SystemExit("Hyprland event socket closed")


def main():
    if sys.argv[1:2] == ["relay"]:
        relay(sys.argv[2])
    elif os.environ.get("KAKAO_NOTIFY_MODE", "popup") == "popup":
        main_popup()
    else:
        main_wal()


def main_wal():
    pattern = os.environ.get("KAKAO_CHAT_DATA_GLOB", DEFAULT_GLOB)
    last = {}  # room file name -> monotonic time of the event that started its burst
    muted = Muted()
    watcher = None

    def stop(*_):
        if watcher and watcher.poll() is None:
            watcher.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    while True:
        dirs = sorted(d for d in glob.glob(pattern) if os.path.isdir(d))
        if not dirs:
            time.sleep(RESCAN)
            continue
        watcher = subprocess.Popen(
            ["inotifywait", "-q", "-m", "-e", "modify", "-e", "close_write", "--format", "%f", *dirs],
            stdout=subprocess.PIPE, text=True, bufsize=1,
        )
        for line in watcher.stdout:
            name = line.rstrip("\n")
            match = ROOM_FILE.match(name)
            if not match:
                continue
            now = time.monotonic()
            if now - last.get(name, -DEBOUNCE) < DEBOUNCE:
                continue
            last[name] = now  # also set when suppressed, so the rest of the burst stays quiet
            room = match.group(1)
            if room in muted or active_class().lower() == KAKAO_CLASS:
                continue
            threading.Thread(target=notify, args=(room, muted), daemon=True).start()
        watcher.wait()
        log(f"inotifywait exited ({watcher.returncode}); rescanning in {RESCAN}s")
        time.sleep(RESCAN)


if __name__ == "__main__":
    main()

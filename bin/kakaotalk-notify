#!/usr/bin/env python3
"""Desktop notification when a KakaoTalk chat receives a message; clicking it shows KakaoTalk.

This KakaoTalk never opens popup windows for new messages, but it rewrites the room's
chat_data/chatLogs_<roomId>.edb-wal when one arrives. This daemon watches those files with
inotifywait (names only; the encrypted contents are never read) and sends one notification
per room per burst. Nothing is sent while a KakaoTalk window is focused.

KakaoTalk's own per-room mute setting sits in an encrypted database, so rooms are muted here
instead: every notification has a "이 방 알림 끄기" button that adds the room id to
~/.config/kakaotalk-notify/muted (one id per line; delete a line to unmute). Clicking the
notification itself opens KakaoTalk.

Usage: kakaotalk-notify   (started by Hyprland autostart; see docs/notifications.md)

Testing overrides:
  KAKAO_CHAT_DATA_GLOB  glob of chat_data dirs to watch
  KAKAO_NOTIFY_MUTED    path of the muted-rooms file
  NOTIFY_CMD            command prefix; headline, body and room id are appended; a stdout line
                        "mute" or "default" is handled like the notification's action
  ACTIVE_CLASS_CMD      command printing the active window class
"""
import glob
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time

ICON = os.path.expanduser("~/.local/share/icons/kakaotalk.png")
DEFAULT_GLOB = os.path.expanduser(
    "~/.local/share/kakaotalk-ec/prefix/drive_c/users/*/AppData/Local/Kakao/KakaoTalk/users/*/chat_data"
)
ROOM_FILE = re.compile(r"^chatLogs_(\d+)\.edb-wal$")
HEADLINE = "카카오톡"
BODY = "새 메시지"
DEBOUNCE = 5.0  # seconds; one message is a burst of writes within about a second
RESCAN = 30  # seconds between looks for account dirs
KAKAO_CLASS = "kakaotalk.exe"


def log(msg):
    print(f"kakaotalk-notify: {msg}", file=sys.stderr, flush=True)


def active_class():
    cmd = os.environ.get("ACTIVE_CLASS_CMD")
    try:
        if cmd:
            out = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=2).stdout
            return out.strip()
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout
        return (json.loads(out or "{}") or {}).get("class", "")
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        log(f"active window lookup failed: {e}")
        return ""


MUTED_FILE = os.environ.get("KAKAO_NOTIFY_MUTED") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kakaotalk-notify", "muted")


class Muted:
    """Room ids from MUTED_FILE, re-read whenever the file changes."""

    def __init__(self):
        self.mtime = None
        self.ids = set()
        self.lock = threading.Lock()

    def __contains__(self, room):
        try:
            mtime = os.stat(MUTED_FILE).st_mtime_ns
        except FileNotFoundError:
            mtime = None
        if mtime != self.mtime:
            self.mtime = mtime
            self.ids = set()
            if mtime is not None:
                with open(MUTED_FILE, encoding="utf-8") as f:
                    self.ids = {line.split("#")[0].strip() for line in f} - {""}
        return room in self.ids

    def add(self, room):
        with self.lock:
            if room in self:
                return
            os.makedirs(os.path.dirname(MUTED_FILE), exist_ok=True)
            with open(MUTED_FILE, "a", encoding="utf-8") as f:
                f.write(f"{room}  # muted {time.strftime('%F %T')}\n")
            log(f"muted room {room}")


def notify_argv(room):
    cmd = os.environ.get("NOTIFY_CMD")
    if cmd:
        return shlex.split(cmd) + [HEADLINE, BODY, room]
    return ["notify-send", "--app-name", HEADLINE, "--icon", ICON,
            "--action", "default=열기", "--action", "mute=이 방 알림 끄기", HEADLINE, BODY]


def notify(room, muted):
    """Show one notification and act on the chosen action (runs in its own thread)."""
    try:
        proc = subprocess.Popen(notify_argv(room), stdout=subprocess.PIPE, text=True)
    except OSError as e:
        log(f"notification failed: {e}")
        return
    for line in proc.stdout:
        action = line.strip()
        if action == "mute":
            muted.add(room)
        elif action == "default":
            subprocess.Popen(["kakaotalk"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        elif action:
            print(action, flush=True)
    proc.wait()


def main():
    pattern = os.environ.get("KAKAO_CHAT_DATA_GLOB", DEFAULT_GLOB)
    last = {}  # room file name -> monotonic time of the event that started its burst
    muted = Muted()
    watcher = None

    def stop(*_):
        if watcher and watcher.poll() is None:
            watcher.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    while True:
        dirs = sorted(d for d in glob.glob(pattern) if os.path.isdir(d))
        if not dirs:
            time.sleep(RESCAN)
            continue
        watcher = subprocess.Popen(
            ["inotifywait", "-q", "-m", "-e", "modify", "-e", "close_write", "--format", "%f", *dirs],
            stdout=subprocess.PIPE, text=True, bufsize=1,
        )
        for line in watcher.stdout:
            name = line.rstrip("\n")
            match = ROOM_FILE.match(name)
            if not match:
                continue
            now = time.monotonic()
            if now - last.get(name, -DEBOUNCE) < DEBOUNCE:
                continue
            last[name] = now  # also set when suppressed, so the rest of the burst stays quiet
            room = match.group(1)
            if room in muted or active_class().lower() == KAKAO_CLASS:
                continue
            threading.Thread(target=notify, args=(room, muted), daemon=True).start()
        watcher.wait()
        log(f"inotifywait exited ({watcher.returncode}); rescanning in {RESCAN}s")
        time.sleep(RESCAN)


if __name__ == "__main__":
    main()

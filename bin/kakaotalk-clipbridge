#!/usr/bin/env python3
"""Let KakaoTalk (Wine) paste clipboard images such as Omarchy screenshots.

Wine ignores image/png from the X clipboard, and pushing a screenshot through Hyprland's
XWayland clipboard bridge as image/bmp (~20 MB) hangs the paste and breaks the XWM until
relogin. So while a KakaoTalk window is focused, a PNG-only clipboard is converted to BMP and
put on the *Windows* clipboard from inside the Wine prefix (kakaotalk_clip.py), where KakaoTalk
reads it without any X transfer. Hyprland mirrors Wine's clipboard back to Wayland as image/bmp,
so the original PNG is restored as soon as focus leaves KakaoTalk, before a Wayland app can pull
the large bitmap through XWayland.
"""
import os
import select
import socket
import subprocess
import sys
import time

from kakaotalk_clip import ERRORS, handed_over, restore_png, set_windows_clipboard

KAKAO_CLASS = "kakaotalk.exe"
# Focus that only passes over KakaoTalk (workspace switches, the pointer crossing its window) must
# not take the clipboard over: every handover changes the X selection owner twice. On 2026-10-07
# a quarter of 80 handovers were taken back within 0.45 s. A Ctrl+V sooner than this still works:
# kakaotalk-paste hands the image over itself.
DEBOUNCE = 0.8


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} kakaotalk-clipbridge: {msg}", file=sys.stderr, flush=True)


def paste(*args):
    try:
        return subprocess.run(["wl-paste", *args], capture_output=True, timeout=10).stdout
    except subprocess.TimeoutExpired:
        log(f"wl-paste {' '.join(args)} timed out")
        return b""


def types():
    return paste("--list-types").decode(errors="replace").split()


def hand_over():
    if types() != ["image/png"]:
        return
    png = paste("--no-newline", "--type", "image/png")
    if not png:
        return
    try:
        size = set_windows_clipboard(png)
    except ERRORS as exc:
        log(f"setting the Windows clipboard failed: {exc}")
        return
    log(f"KakaoTalk focused: image ({len(png)} bytes PNG, {size} bytes DIB) put on the Windows clipboard")


def take_back():
    if not handed_over():
        return
    try:
        result = restore_png(types())
    except ERRORS as exc:
        result = f"restoring the PNG failed: {exc}"
    if result:
        log(f"KakaoTalk unfocused: {result}")


def kakao_is_focused():
    try:
        active = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True,
                                timeout=10).stdout
    except subprocess.TimeoutExpired:
        log("hyprctl activewindow timed out")
        return False
    return f'"class": "{KAKAO_CLASS}"' in active


def main():
    sock_path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                             os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(sock_path)
    # Screenshots taken while KakaoTalk is focused change the clipboard without any focus
    # event (the region picker is a layer surface), so watch the clipboard as well.
    watch = subprocess.Popen(["wl-paste", "--watch", "echo", "changed"], stdout=subprocess.PIPE)
    in_kakao = kakao_is_focused()
    # When to hand the clipboard over, if KakaoTalk is still focused by then.
    deadline = time.monotonic() if in_kakao else None
    if not in_kakao:
        take_back()
    log("listening for focus and clipboard changes")
    buf = b""
    while True:
        timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
        ready, _, _ = select.select([sock, watch.stdout], [], [], timeout)
        if watch.stdout in ready:
            if not os.read(watch.stdout.fileno(), 4096):
                raise SystemExit("wl-paste --watch exited")
            if in_kakao:
                deadline = time.monotonic() + DEBOUNCE
        if sock in ready:
            chunk = sock.recv(65536)
            if not chunk:
                raise SystemExit("Hyprland event socket closed")
            *lines, buf = (buf + chunk).split(b"\n")
            for line in lines:
                event, _, payload = line.decode(errors="replace").partition(">>")
                if event != "activewindow":
                    continue
                now_kakao = payload.split(",", 1)[0] == KAKAO_CLASS
                if now_kakao and not in_kakao:
                    deadline = time.monotonic() + DEBOUNCE
                elif in_kakao and not now_kakao:
                    deadline = None
                    take_back()
                in_kakao = now_kakao
        if deadline is not None and time.monotonic() >= deadline:
            deadline = None
            hand_over()


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Ctrl+V for KakaoTalk (Wine): paste files copied in a file manager as attachments.

KakaoTalk's Ctrl+V ignores files on the clipboard and pastes their paths as text, but its chat
windows accept file drops. Hyprland binds Ctrl+V to this script only while a KakaoTalk window is
focused (~/.config/hypr/hyprland.lua). If the clipboard holds local files (text/uri-list), they are
dropped onto the chat window Hyprland has focused, matched by title and geometry from
`hyprctl activewindow` (dropfiles.py inside the Wine prefix); otherwise, or if no single window
matches or takes the drop, the real Ctrl+V is passed on, so text and images paste as before.

kakaotalk-clipbridge puts a PNG-only clipboard on the Windows clipboard when KakaoTalk gains focus,
but Wine's own import of the X selection (which Hyprland sets at the same moment) can overwrite it
with an empty clipboard. So if the clipboard is still PNG-only here (the bridge's image never made
it to Wine, or Wine would have mirrored it back as image/bmp), it is put on the Windows clipboard
again right before the Ctrl+V, when nothing else races it.
"""
import json
import os
import subprocess
import sys
import time
from urllib.parse import unquote, urlsplit

KAKAOTALK = os.path.expanduser("~/.local/bin/kakaotalk")
PY_DIR = os.path.expanduser("~/.local/share/kakaotalk-ec/py")
CLIP_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kakaotalk-clip")


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} kakaotalk-paste: {msg}", file=sys.stderr, flush=True)


def paste(*args):
    return subprocess.run(["wl-paste", *args], capture_output=True, timeout=10).stdout


def local_files():
    """Paths on the clipboard if it holds only existing local files, else None."""
    if "text/uri-list" not in paste("--list-types").decode(errors="replace").split():
        return None
    uris = [line.strip() for line in paste("--no-newline", "--type", "text/uri-list")
            .decode(errors="replace").splitlines() if line.strip() and not line.startswith("#")]
    paths = []
    for uri in uris:
        parts = urlsplit(uri)
        if parts.scheme != "file" or parts.netloc not in ("", "localhost"):
            return None
        paths.append(unquote(parts.path))
    return paths if paths and all(os.path.isfile(p) for p in paths) else None


def put_png_on_windows_clipboard():
    """Same conversion as kakaotalk-clipbridge: PNG -> BMP -> CF_DIB via setclip.py in Wine."""
    png = paste("--no-newline", "--type", "image/png")
    if not png:
        return
    os.makedirs(CLIP_DIR, exist_ok=True)
    bmp = os.path.join(CLIP_DIR, "clip.bmp")
    try:
        subprocess.run(["magick", "png:-", "-background", "white", "-alpha", "remove", "-alpha", "off",
                        f"bmp3:{bmp}"], input=png, check=True, timeout=30, capture_output=True)
        subprocess.run([KAKAOTALK, "wine", f"Z:{PY_DIR}/python.exe", f"Z:{PY_DIR}/setclip.py", f"Z:{bmp}"],
                       check=True, timeout=60, capture_output=True)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
        log(f"setting the Windows clipboard failed: {exc}")
        return
    log(f"image ({len(png)} bytes PNG) put on the Windows clipboard before Ctrl+V")


def send_ctrl_v():
    # Synthetic keys go straight to the focused window without triggering this binding again.
    for state in ("down", "up"):
        subprocess.run(["hyprctl", "dispatch",
                        f'hl.dsp.send_key_state({{ mods = "CTRL", key = "V", state = "{state}" }})'],
                       capture_output=True, timeout=5)
        time.sleep(0.05)


def focused_window():
    """Title and geometry of the focused window if it is KakaoTalk's, else None."""
    out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=5).stdout
    try:
        win = json.loads(out)
        if win.get("class") != "kakaotalk.exe":
            return None
        (x, y), (w, h) = win["at"], win["size"]
        return win["title"], [str(int(v)) for v in (x, y, w, h)]
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def main():
    paths = local_files()
    target = focused_window() if paths else None
    if paths and target:
        title, geometry = target
        result = subprocess.run([KAKAOTALK, "wine", f"Z:{PY_DIR}/python.exe", "-X", "utf8",
                                 f"Z:{PY_DIR}/dropfiles.py", "--target", title, *geometry, *paths],
                                capture_output=True, text=True, timeout=60)
        if result.returncode == 0:
            log(f"dropped {len(paths)} file(s) on {title!r}")
            return
        if result.returncode == 4:
            # The drop was delivered and KakaoTalk is still handling it (e.g. its confirm dialog
            # is open): a passed-through Ctrl+V would paste the paths as text on top of it.
            log(f"warning: {title!r} did not finish handling the drop in time: {result.stderr.strip()[-300:]}")
            return
        if result.returncode != 3:
            log(f"drop failed ({result.returncode}): {result.stderr.strip()[-300:]}")
    elif not paths and paste("--list-types").decode(errors="replace").split() == ["image/png"]:
        put_png_on_windows_clipboard()
    send_ctrl_v()


if __name__ == "__main__":
    main()

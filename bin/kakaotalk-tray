#!/usr/bin/env python3
"""KakaoTalk icon for the Omarchy bar (StatusNotifierItem); clicking it shows KakaoTalk.

Wine's own tray icon is XEmbed, which the bar can't show, and bridging it with xembedsniproxy
stole KakaoTalk's keyboard input. This item never touches X11: clicking runs `kakaotalk`,
which brings back a running KakaoTalk's hidden window (or starts it). No unread badge.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

ICON = os.path.expanduser("~/.local/share/icons/kakaotalk.png")
LAUNCHER = os.path.expanduser("~/.local/bin/kakaotalk")
ITEM_PATH = "/StatusNotifierItem"

XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewStatus"><arg name="status" type="s"/></signal>
  </interface>
</node>
"""


def argb_pixmaps():
    """IconPixmap wants ARGB32 in network byte order; ImageMagick gives RGBA."""
    pixmaps = []
    for size in (22, 32, 48, 80):
        rgba = subprocess.run(["magick", ICON, "-resize", f"{size}x{size}", "-depth", "8", "rgba:-"],
                              capture_output=True, check=True).stdout
        argb = bytearray(len(rgba))
        argb[0::4], argb[1::4], argb[2::4], argb[3::4] = rgba[3::4], rgba[0::4], rgba[1::4], rgba[2::4]
        pixmaps.append((size, size, bytes(argb)))
    return pixmaps


def show_kakaotalk():
    subprocess.Popen([LAUNCHER], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


class Item:
    def __init__(self):
        self.pixmaps = argb_pixmaps()
        self.props = {
            "Category": GLib.Variant("s", "Communications"),
            "Id": GLib.Variant("s", "kakaotalk"),
            "Title": GLib.Variant("s", "카카오톡"),
            "Status": GLib.Variant("s", "Active"),
            "IconName": GLib.Variant("s", ""),
            "IconPixmap": GLib.Variant("a(iiay)", self.pixmaps),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", ("", [], "카카오톡", "클릭하면 카카오톡 창을 엽니다")),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", "/NO_DBUSMENU"),
        }

    def on_call(self, conn, sender, path, iface, method, params, invocation):
        if method in ("Activate", "SecondaryActivate", "ContextMenu"):
            show_kakaotalk()
        invocation.return_value(None)

    def on_get(self, conn, sender, path, iface, prop):
        return self.props.get(prop)


def main():
    item = Item()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    bus.register_object(ITEM_PATH, node.interfaces[0], item.on_call, item.on_get, None)
    name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"

    def register(*_):
        bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                 "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                 GLib.Variant("(s)", (name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)
        print(f"kakaotalk-tray: registered {name}", file=sys.stderr, flush=True)

    Gio.bus_own_name_on_connection(bus, name, Gio.BusNameOwnerFlags.NONE, None, None)
    # Register now and again whenever the bar (the watcher) restarts.
    Gio.bus_watch_name_on_connection(bus, "org.kde.StatusNotifierWatcher",
                                     Gio.BusNameWatcherFlags.NONE, register, None)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
